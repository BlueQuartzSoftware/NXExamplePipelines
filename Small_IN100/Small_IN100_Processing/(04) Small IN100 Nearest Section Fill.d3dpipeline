          "version": 1
        },
        "difference_map_array_path": {
          "value": "NearestSectionFill/Cell Data/FeatureIdDifference",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Compare copied feature labels with the complete withheld reference. The temporary int32 absolute label difference is used only to detect inequality; its magnitude has no physical meaning.",
      "isDisabled": false
    },
    {
      "args": {
        "array_thresholds_object": {
          "value": {
            "inverted": false,
            "thresholds": [
              {
                "array_path": "NearestSectionFill/Cell Data/FeatureIdDifference",
                "comparison": 0,
                "component_index": 0,
                "inverted": false,
                "type": "array",
                "union": 0,
                "value": 0.0
              }
            ],
            "type": "collection",
            "union": 0
          },
          "version": 2
        },
        "created_mask_type": {
          "value": 10,
          "version": 1
        },
        "custom_false_value": {
          "value": 0.0,
          "version": 1
        },
        "custom_true_value": {
          "value": 1.0,
          "version": 1
        },
        "output_data_array_name": {
          "value": "FeatureIdMismatch",
          "version": 1
        },
        "parameters_version": 1,
        "use_custom_false_value": {
          "value": false,
          "version": 1
        },
        "use_custom_true_value": {
          "value": false,
          "version": 1
        }
      },
      "comments": "Create boolean FeatureIdMismatch where the copied feature label differs from the withheld reference (absolute difference > 0). This controlled-reference comparison is not a mask that detects real acquisition gaps.",
      "filter": {
        "name": "nx::core::MultiThresholdObjectsFilter",
        "uuid": "4246245e-1011-4add-8436-0af6bed19228"
      },
      "isDisabled": false
