      },
      "args": {
        "removed_data_path": {
          "value": [
            "MissingSections_OrdinalStack",
            "NearestSectionFill/Cell Data/FeatureIdDifference"
          ],
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Remove the ordinal input and temporary numerical label difference. Retain only the boolean mismatch comparison, full reference, uniform fill and provenance; label-difference magnitude is not a physical metric.",
      "isDisabled": false
    },
