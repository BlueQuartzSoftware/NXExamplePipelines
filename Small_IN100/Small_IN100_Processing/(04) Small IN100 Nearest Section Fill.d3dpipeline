            "path_import_policy": 0
          },
          "version": 2
        },
        "parameters_version": 1
      },
      "comments": "Read the completed Missing Sections Preparation checkpoint, including the full eight-section reference, five retained sections and provenance metadata. The generated decision text file must also exist before preflight.",
      "isDisabled": false
    },
    {
      "filter": {
        "name": "nx::core::RegularizeZSpacingFilter",
        "uuid": "d6599986-1932-4bfc-993d-71eafefe6db0"
      },
      "args": {
        "input_image_geometry_path": {
          "value": "MissingSections_OrdinalStack",
          "version": 1
        },
