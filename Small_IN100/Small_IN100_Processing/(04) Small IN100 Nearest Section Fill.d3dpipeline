          "value": false,
          "version": 1
        },
        "output_image_geometry_path": {
          "value": "NearestSectionFill",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Copy the nearest retained observation using derived first-section-relative midpoint decision thresholds. Boundary ties select the lower retained Z. No averaging or physical Z recalibration is performed.",
      "isDisabled": false
    },
    {
      "filter": {
        "name": "nx::core::ComputeDifferencesMapFilter",
        "uuid": "5a0ee5b5-c135-4535-85d0-9c2058943099"
      },
      "args": {
