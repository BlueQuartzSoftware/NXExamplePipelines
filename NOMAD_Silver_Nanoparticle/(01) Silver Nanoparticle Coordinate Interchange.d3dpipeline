{
  "isDisabled": false,
  "name": "(01) Silver Nanoparticle Coordinate Interchange.d3dpipeline",
  "pinnedParams": [],
  "pipeline": [
    {
      "args": {
        "data_object_path": {
          "value": "Source",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Create a source checkpoint group for the original fractional coordinates and selective-dynamics flags.",
      "filter": {
        "name": "nx::core::CreateDataGroupFilter",
        "uuid": "e7d2f9b8-4131-4b28-a843-ea3c6950f101"
      },
      "isDisabled": false
    },
    {
      "args": {
        "read_csv_data_object": {
          "value": {
            "Custom Headers": [
              "FractionalX",
              "FractionalY",
              "FractionalZ",
              "SelectiveX",
              "SelectiveY",
              "SelectiveZ"
            ],
            "Data Types": [
              9,
              9,
              9,
              11,
              11,
              11
            ],
            "Skipped Array Mask": [
              false,
              false,
              false,
              false,
              false,
              false
            ],
            "Tuple Dimensions": [
              1415
            ],
            "Input File Path": "Data/NOMAD_Silver_Nanoparticle/Ag1415ico.CONTCAR",
            "Start Import Row": 10,
            "Header Line": 1,
            "Header Mode": 1,
            "Delimiters": [
              " ",
              "\t"
            ],
            "Consecutive Delimiters": false
          },
          "version": 1
        },
        "use_existing_group": {
          "value": false,
          "version": 1
        },
        "selected_attribute_matrix_path": {
          "value": "",
          "version": 1
        },
        "created_data_group_path": {
          "value": "Source/Atoms",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Read exactly 1415 atom records from original CONTCAR lines 10-1424. This explicit whitespace-table schema preserves six columns and stops before the trailing zero-velocity block; it is not a general VASP reader.",
      "filter": {
        "name": "nx::core::ReadCSVFileFilter",
        "uuid": "373be1f8-31cf-49f6-aa5d-e356f4f3f261"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_data_array_paths": {
          "value": [
            "Source/Atoms/FractionalX",
            "Source/Atoms/FractionalY",
            "Source/Atoms/FractionalZ"
          ],
          "version": 1
        },
        "output_data_array_name": {
          "value": "FractionalXYZ",
          "version": 1
        },
        "normalize_data": {
          "value": false,
          "version": 1
        },
        "move_values": {
          "value": false,
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Combine FractionalX, FractionalY, FractionalZ in that order. Preserve their values and source columns: normalization and removal are disabled.",
      "filter": {
        "name": "nx::core::CombineAttributeArraysFilter",
        "uuid": "2436b614-e96d-47f0-9f6f-41d6fe97acd4"
      },
      "isDisabled": false
    },
    {
      "args": {
        "calculator_parameter": {
          "value": {
            "equation": "FractionalXYZ * 50",
            "units": 0,
            "selected_group": "Source/Atoms"
          },
          "version": 1
        },
        "scalar_type_index": {
          "value": 9,
          "version": 1
        },
        "calculated_array_path": {
          "value": "Source/Atoms/CartesianAngstrom64",
          "version": 1
        },
        "parameters_version": 2
      },
      "comments": "Convert Direct fractional coordinates to Cartesian angstroms in Float64. Multiplication by 50 is valid only for this verified scale-1 diagonal 50 angstrom cell; it is not a general lattice transform.",
      "filter": {
        "name": "nx::core::ArrayCalculatorFilter",
        "uuid": "eea49b17-0db2-5bbc-80ef-f44249cc8d55"
      },
      "isDisabled": false
